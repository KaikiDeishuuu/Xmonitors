{
  "global": {
    "default_interval_seconds": 60,
    "request_timeout_seconds": 15,
    "max_retries": 3,
    "retry_backoff_seconds": 5,
    "jitter_seconds": 5,
    "user_agent": "Xmonitors/1.0",
    "notify_on_error": false,
    "notify_on_recovery": true
  },
  "telegram": {
    "enabled": true
  },
  "state_path": "data/state.json",
  "items": [
    {
      "name": "Example VPS Product",
      "url": "https://example.com/product",
      "enabled": true,
      "interval_seconds": 60,
      "positive_keywords": ["Order Now", "Add to Cart", "In Stock", "Available"],
      "negative_keywords": ["Out of Stock", "Sold Out", "Unavailable"],
      "blocked_keywords": ["Access Denied", "Too Many Requests", "Just a moment"],
      "regex": null,
      "expected_status": "auto",
      "notify_on_error": false
    }
  ]
}
